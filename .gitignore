# Dependencies
node_modules/
.pnpm-store/

# Build output — regenerated by `pnpm build` (see build.mjs)
lib/

# Build staging directory used by build.mjs
node_modules/.dsh-build/

# TypeScript incremental build info
*.tsbuildinfo

# Logs
*.log
pnpm-debug.log*

# Editor and OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db

# Verification output — every screenshot a step script takes lands in SHOT_DIR
# (`tools/drive.mjs`), which is set to docs/ when the README's images are being
# refreshed. Only those two images belong in the repository; the rest of a run's
# output, including the shots of earlier runs, are artifacts.
docs/shots/
docs/*.png
!docs/panel.png
!docs/graph.png
